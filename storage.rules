rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function logado() { return request.auth != null; }
    // Sessão anônima (compra sem cadastro) não envia arquivo: só contas com e-mail
    function contaComEmail() { return logado() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    // equipe: marca na conta + e-mail confirmado (quem sai da lista PLATAFORMA_EMAILS perde a marca na rotina diária)
    function plataforma() { return logado() && request.auth.token.get('plataforma', false) == true && request.auth.token.get('email_verified', false) == true; }
    function membroAtivo(tid) {
      return logado() && firestore.exists(/databases/(default)/documents/torcidas/$(tid)/membros/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/torcidas/$(tid)/membros/$(request.auth.uid)).data.ativo == true;
    }
    function papel(tid) {
      return firestore.get(/databases/(default)/documents/torcidas/$(tid)/membros/$(request.auth.uid)).data.papel;
    }
    function imagem(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Imagens públicas da torcida
    match /torcidas/{tid}/publico/{arquivo=**} {
      allow read: if true;
    }
    // Escudo e banner: só a diretoria
    match /torcidas/{tid}/publico/marca/{arquivo=**} {
      allow write: if membroAtivo(tid) && papel(tid) == 'diretoria' && imagem(5);
    }
    // Imagens de evento: a subsede envia arquivos novos; trocar ou apagar um existente é da diretoria
    match /torcidas/{tid}/publico/eventos/{arquivo=**} {
      allow create: if membroAtivo(tid) && papel(tid) in ['diretoria', 'subsede'] && imagem(5);
      allow update, delete: if membroAtivo(tid) && papel(tid) == 'diretoria' && (request.resource == null || imagem(5));
    }

    // Foto 3x4 do sócio: o próprio sócio envia; diretoria e portaria consultam.
    // Um arquivo só por sócio (foto.jpg, o nome que o CheckoutSocio usa; trocar a foto sobrescreve): a pasta
    // não vira depósito de arquivos. A adesão exige conta com e-mail, então anônimo não envia.
    match /torcidas/{tid}/socios/{uid}/{arquivo} {
      allow read: if (logado() && request.auth.uid == uid) || membroAtivo(tid) || plataforma();
      allow write: if contaComEmail() && request.auth.uid == uid && arquivo == 'foto.jpg' && imagem(3);
    }

    // Vídeo de verificação do cadastro da torcida: só quem enviou e a equipe veem; ninguém troca nem apaga (é a prova)
    // Só na pasta de uma solicitação do próprio usuário, ainda pendente e sem vídeo aceito: antes qualquer conta
    // enviava vídeos de 500 MB sem limite (custo de armazenamento).
    function solicitacaoAberta(uid, sol) {
      let s = firestore.get(/databases/(default)/documents/solicitacoes/$(sol)).data;
      return s.uid == uid && s.status == 'pendente' && s.get('verificacao', {}).get('status', '') != 'enviado';
    }
    match /verificacoes/{uid}/{arquivo=**} {
      allow read: if (logado() && request.auth.uid == uid) || plataforma();
    }
    match /verificacoes/{uid}/{sol}/{arquivo} {
      allow create: if contaComEmail() && request.auth.uid == uid && request.auth.token.get('email_verified', false) == true
        && resource == null && solicitacaoAberta(uid, sol)
        && request.resource.size < 500 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
    }

    // Anexos do suporte (foto, print, áudio, PDF): pasta do dono do chamado. O dono e a equipe enviam e leem;
    // ninguém sobrescreve nem apaga (é o histórico da conversa).
    function anexoSuporte() {
      return (request.resource.contentType.matches('image/(jpeg|png|webp|gif)') && request.resource.size < 15 * 1024 * 1024)
        || (request.resource.contentType.matches('audio/.*') && request.resource.size < 15 * 1024 * 1024)
        || (request.resource.contentType == 'application/pdf' && request.resource.size < 10 * 1024 * 1024);
    }
    // O chamado tem que existir e ser do dono da pasta (antes a pasta aceitava arquivos sem chamado nenhum)
    function chamadoDe(uid, chamado) {
      return firestore.exists(/databases/(default)/documents/suporte/$(chamado))
        && firestore.get(/databases/(default)/documents/suporte/$(chamado)).data.uid == uid;
    }
    match /suporte/{uid}/{chamado}/{arquivo} {
      allow read: if (logado() && request.auth.uid == uid) || plataforma();
      allow create: if ((contaComEmail() && request.auth.uid == uid) || plataforma()) && resource == null && anexoSuporte()
        && chamadoDe(uid, chamado);
    }
  }
}
