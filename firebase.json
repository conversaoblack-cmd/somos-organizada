{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "test",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/pagarme/webhook/**",
        "function": {
          "functionId": "pagarmeWebhook",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/entrar",
        "destination": "/app.html"
      },
      {
        "source": "/cadastro",
        "destination": "/app.html"
      },
      {
        "source": "/verificar",
        "destination": "/app.html"
      },
      {
        "source": "/convite",
        "destination": "/app.html"
      },
      {
        "source": "/redefinir-senha",
        "destination": "/app.html"
      },
      {
        "source": "/termos",
        "destination": "/app.html"
      },
      {
        "source": "/privacidade",
        "destination": "/app.html"
      },
      {
        "source": "/plataforma",
        "destination": "/app.html"
      },
      {
        "source": "/plataforma/**",
        "destination": "/app.html"
      },
      {
        "source": "/e/*",
        "function": {
          "functionId": "previaLink",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/evento/*",
        "function": {
          "functionId": "previaLink",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/*",
        "function": {
          "functionId": "previaLink",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/*/e/*",
        "function": {
          "functionId": "previaLink",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/*/evento/*",
        "function": {
          "functionId": "previaLink",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Content-Security-Policy",
            "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
          },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.firebaseio.com https://api.pagar.me https://viacep.com.br https://firebasestorage.googleapis.com; frame-src 'self' https://*.firebaseapp.com https://www.youtube.com; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fontes/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/tutoriais/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
