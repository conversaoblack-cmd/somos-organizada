rules_version = '2';

// Princípio: dinheiro, status de sócio, ingressos e credenciais só são escritos pelo servidor
// (Cloud Functions). O navegador escreve apenas conteúdo editorial da diretoria
// (eventos, planos, sedes, aparência) e mensagens de suporte.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function anonimo() { return logado() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // equipe: marca na conta + e-mail confirmado (quem sai da lista PLATAFORMA_EMAILS perde a marca na rotina diária)
    function plataforma() { return logado() && request.auth.token.get('plataforma', false) == true && request.auth.token.get('email_verified', false) == true; }

    function membro(tid) {
      return logado() && exists(/databases/$(database)/documents/torcidas/$(tid)/membros/$(request.auth.uid))
        && get(/databases/$(database)/documents/torcidas/$(tid)/membros/$(request.auth.uid)).data.ativo == true;
    }
    function papel(tid) {
      return get(/databases/$(database)/documents/torcidas/$(tid)/membros/$(request.auth.uid)).data.papel;
    }
    function sedeDoMembro(tid) {
      return get(/databases/$(database)/documents/torcidas/$(tid)/membros/$(request.auth.uid)).data.get('sedeId', '');
    }
    // Escopo de subsede: a sede do membro precisa existir (nunca vazia). Sem isso, um membro sem sedeId
    // "casaria" com documentos sem sedeId (sedeId == '' ou ausente).
    function naMinhaSede(tid, sedeId) {
      return sedeDoMembro(tid) != '' && sedeDoMembro(tid) == sedeId;
    }
    function diretoria(tid) { return membro(tid) && papel(tid) == 'diretoria'; }
    function gestor(tid) { return membro(tid) && papel(tid) in ['diretoria', 'subsede']; }
    function daMinhaSede(tid, sedeId) {
      return diretoria(tid) || (membro(tid) && papel(tid) == 'subsede' && naMinhaSede(tid, sedeId));
    }
    function apenas(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    function corValida(c) { return c is string && c.matches('^#[0-9A-Fa-f]{6}$'); }
    // Escudo e banner: só arquivo do nosso Storage (o painel envia e grava o link). Endereço de fora viraria imagem
    // de rastreio nos e-mails e na página da torcida.
    function imagemNossa(u) {
      return u == null || u == '' || (u is string && u.size() <= 1000
        && (u.matches('/[A-Za-z0-9._-][A-Za-z0-9._/-]{0,200}')
          || u.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/torcidas%2F.*')
          || u.matches('http://(127[.]0[.]0[.]1|localhost):9199/v0/b/[^/]+/o/torcidas%2F.*')));
    }
    function temaSeguro(t) {
      return t is map && corValida(t.corPrimaria) && corValida(t.corSecundaria) && corValida(t.corFundo) && corValida(t.corTexto)
        && imagemNossa(t.get('logoUrl', null)) && imagemNossa(t.get('bannerUrl', null));
    }

    match /slugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Domínio próprio → torcida (o site descobre a torcida pelo endereço). Público só por documento;
    // a lista é da equipe. Gravado só pelo servidor (api/dominios.ts); sem segredos.
    match /dominios/{host} {
      allow get: if true;
      allow list: if plataforma();
      allow write: if false;
    }

    match /torcidas/{tid} {
      // página pública (nome, tema, chave pública Pagar.me, status): lê uma por vez; listar todas (inclusive as que
      // ainda não publicaram) só a equipe
      allow get: if true;
      allow list: if plataforma();
      // Diretoria edita só aparência, textos, contato e regras de sócio. Status, taxa, pagamentos e domínio: servidor.
      allow update: if diretoria(tid)
        && apenas(['tema', 'textos', 'contato', 'aprovacaoManualSocio', 'destinoMensalidade', 'modulos'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tema']) || temaSeguro(request.resource.data.tema))
        && request.resource.data.destinoMensalidade in ['sede_do_socio', 'principal'];
      allow create, delete: if false;

      match /privado/{doc} {
        allow read, write: if false; // credenciais cifradas e contrato: somente servidor
      }

      // Mensalidade Somos Organizada: assinatura, cadastro fiscal e faturas (gravados pelo servidor)
      match /saas/{doc} {
        allow read: if diretoria(tid) || plataforma();
        allow write: if false;
      }
      match /faturasSaas/{id} {
        allow read: if diretoria(tid) || plataforma();
        allow write: if false;
      }
      // Estado interno da Pagar.me simulada (modo demonstração)
      match /demoPagarme/{doc=**} {
        allow read, write: if false;
      }

      match /sedes/{sedeId} {
        allow read: if true;
        // "recebedor" (conta de recebimento na Pagar.me) só é gravado pelo servidor
        allow create: if diretoria(tid) && request.resource.data.tipo == 'subsede' && !('recebedor' in request.resource.data);
        allow update: if diretoria(tid) && request.resource.data.tipo == resource.data.tipo
          && request.resource.data.get('recebedor', null) == resource.data.get('recebedor', null);
        allow delete: if false; // desativar com ativa=false para não quebrar histórico

        // Dados da conta de recebimento (titular, banco, link da prova de vida): só quem cadastrou, e enquanto for
        // o usuário daquela subsede. A diretoria vê apenas a situação (campo "recebedor" da sede, público) e não
        // consegue ler os dados criando outro usuário para a subsede.
        match /privado/{doc} {
          allow read: if membro(tid) && papel(tid) == 'subsede' && naMinhaSede(tid, sedeId)
            && resource.data.cadastradoPor == request.auth.uid;
          allow write: if false;
        }
      }

      match /planos/{planoId} {
        allow read: if true;
        allow create, update: if diretoria(tid)
          && request.resource.data.valor is int && request.resource.data.valor >= 100
          && request.resource.data.intervalo in ['mes', 'ano']
          && request.resource.data.intervaloQtd is int && request.resource.data.intervaloQtd >= 1 && request.resource.data.intervaloQtd <= 12
          && request.resource.data.ativo is bool;
        allow delete: if false;
      }

      match /eventos/{eventoId} {
        // Subsede cria e edita só rascunho / "em aprovação". Publicar (pôr à venda) é só pelo servidor, na ação
        // publicarEvento (diretoria; confere o limite de eventos à venda do plano e, em subsede, a conta de
        // recebimento ativa). Aqui a diretoria só edita um evento que JÁ está publicado, mantendo publicado.
        function sedeDoEvento(sedeId) {
          return get(/databases/$(database)/documents/torcidas/$(tid)/sedes/$(sedeId)).data;
        }
        function podePublicar(sedeId) {
          return sedeDoEvento(sedeId).tipo == 'principal'
            || sedeDoEvento(sedeId).get('recebedor', {}).get('status', '') == 'active';
        }
        function statusPermitido(d) {
          return (papel(tid) == 'diretoria' && d.status in ['rascunho', 'em_aprovacao', 'encerrado', 'cancelado'])
            || (papel(tid) == 'subsede' && d.status in ['rascunho', 'em_aprovacao']);
        }
        function continuaPublicado() {
          return papel(tid) == 'diretoria' && resource.data.status == 'publicado' && request.resource.data.status == 'publicado'
            && podePublicar(request.resource.data.sedeId)
            // evento que já passou não volta a ficar à venda trocando só a data: isso passa pelo limite do plano (publicarEvento)
            && !(resource.data.data < request.time && request.resource.data.data >= request.time);
        }
        function valoresValidos(d) {
          return d.valorSocio is int && d.valorPublico is int && d.valorSocio >= 0 && d.valorPublico > 0;
        }
        // Código do link direto (/torcida/e/codigo): 6 caracteres sem ambíguos; uma vez dado, não muda.
        function codigoValido(d) {
          return !('codigo' in d) || (d.codigo is string && d.codigo.matches('^[a-hjkmnp-z2-9]{6}$'));
        }
        function codigoMantido() {
          return request.resource.data.get('codigo', '') == resource.data.get('codigo', '') || !('codigo' in resource.data);
        }

        allow read: if resource.data.status in ['publicado', 'encerrado'] || gestor(tid) || plataforma();
        allow create: if daMinhaSede(tid, request.resource.data.sedeId)
          && request.resource.data.vendidos == 0 && request.resource.data.reservados == 0
          && valoresValidos(request.resource.data) && codigoValido(request.resource.data)
          && statusPermitido(request.resource.data);
        // contadores (vendidos, reservados, entradas) são do servidor
        allow update: if daMinhaSede(tid, resource.data.sedeId)
          && daMinhaSede(tid, request.resource.data.sedeId)
          && request.resource.data.vendidos == resource.data.vendidos
          && request.resource.data.reservados == resource.data.reservados
          && request.resource.data.get('entradas', 0) == resource.data.get('entradas', 0)
          && valoresValidos(request.resource.data) && codigoValido(request.resource.data) && codigoMantido()
          && (statusPermitido(request.resource.data) || continuaPublicado())
          && (papel(tid) == 'diretoria' || resource.data.status in ['rascunho', 'em_aprovacao']);
        allow delete: if daMinhaSede(tid, resource.data.sedeId) && resource.data.vendidos == 0 && resource.data.reservados == 0
          && (papel(tid) == 'diretoria' || resource.data.status in ['rascunho', 'em_aprovacao']);
      }

      // Subsede não tem a página Sócios, mas o painel dela conta os sócios da própria sede (visão geral e
      // "aguardando aprovação", que ela pode aprovar): por isso continua lendo, só os da sede dela.
      match /socios/{uid} {
        allow read: if (logado() && request.auth.uid == uid)
          || diretoria(tid) || (gestor(tid) && naMinhaSede(tid, resource.data.get('sedeId', '')));
        allow write: if false;
      }

      match /cpfs/{cpf} { allow read, write: if false; }

      match /pedidos/{pedidoId} {
        allow read: if (logado() && resource.data.uid == request.auth.uid)
          || diretoria(tid) || (gestor(tid) && naMinhaSede(tid, resource.data.get('sedeId', '')));
        allow write: if false;
      }

      match /ingressos/{ingressoId} {
        allow read: if (logado() && resource.data.uid == request.auth.uid)
          || diretoria(tid) || (membro(tid) && naMinhaSede(tid, resource.data.get('sedeId', '')));
        allow write: if false;
      }

      match /lancamentos/{id} {
        allow read: if diretoria(tid) || (gestor(tid) && naMinhaSede(tid, resource.data.get('sedeId', '')));
        allow write: if false;
      }

      // Repasses: diretoria registra o que já transferiu para cada subsede.
      match /repasses/{id} {
        allow read: if diretoria(tid) || (gestor(tid) && naMinhaSede(tid, resource.data.get('sedeId', '')));
        allow create: if diretoria(tid) && request.resource.data.valor is int && request.resource.data.valor > 0
          && request.resource.data.registradoPor == request.auth.uid;
        allow update: if diretoria(tid) && apenas(['comprovanteUrl', 'observacao', 'status']);
        allow delete: if false;
      }

      match /stats/{id} {
        allow read: if gestor(tid) || plataforma();
        allow write: if false;
      }

      match /membros/{uid} {
        allow read: if (logado() && request.auth.uid == uid) || diretoria(tid) || plataforma();
        allow write: if false; // via convidarMembro / atualizarMembro
      }

      match /webhooks/{id} {
        allow read: if diretoria(tid) || plataforma();
        allow write: if false;
      }
    }

    // Preferências do próprio usuário (ex.: quais tutoriais já viu)
    match /usuarios/{uid}/preferencias/{doc} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Rascunho do cadastro de torcida: continua de onde parou em qualquer aparelho. Só o dono lê e grava.
    match /usuarios/{uid}/rascunhos/{doc} {
      allow read, delete: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid && doc == 'cadastroTorcida'
        && request.resource.data.keys().hasOnly(['dados', 'passo', 'atualizadoEm'])
        && request.resource.data.dados is map && request.resource.data.dados.size() <= 30
        && request.resource.data.passo is int && request.resource.data.passo >= 2 && request.resource.data.passo <= 5
        && request.resource.data.atualizadoEm is int;
    }

    match /usuarios/{uid}/acessos/{tid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Suporte ──────────────────────────────────────────────
    match /suporte/{chamadoId} {
      allow read: if plataforma() || (logado() && resource.data.uid == request.auth.uid);
      // Campos exatamente os que o SuporteFlutuante grava; datas do servidor; tamanhos limitados.
      function textoAte(v, max) { return v is string && v.size() <= max; }
      // id só com letras, números, - e _ (o id entra na expressão que confere a pasta dos anexos)
      allow create: if logado() && !anonimo() && chamadoId.matches('[A-Za-z0-9_-]{6,64}')
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'torcidaId', 'torcidaNome', 'papel', 'assunto',
             'status', 'naoLidasPlataforma', 'diagnostico', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'aberto'
        && request.resource.data.naoLidasPlataforma == 1
        && textoAte(request.resource.data.assunto, 140)
        && textoAte(request.resource.data.nome, 200)
        && textoAte(request.resource.data.get('torcidaId', ''), 64)
        && textoAte(request.resource.data.get('torcidaNome', ''), 200)
        && request.resource.data.get('papel', 'torcedor') in ['diretoria', 'subsede', 'portaria', 'socio', 'torcedor']
        && (!('diagnostico' in request.resource.data)
            || (request.resource.data.diagnostico is map && request.resource.data.diagnostico.size() <= 20))
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      // Dono do chamado: reabre (nova mensagem soma 1 em naoLidasPlataforma) ou marca como resolvido.
      allow update: if plataforma()
        || (logado() && resource.data.uid == request.auth.uid && apenas(['status', 'atualizadoEm', 'naoLidasPlataforma'])
            && request.resource.data.status in ['aberto', 'resolvido']
            && request.resource.data.atualizadoEm == request.time
            && (request.resource.data.get('naoLidasPlataforma', 0) == resource.data.get('naoLidasPlataforma', 0)
                || request.resource.data.get('naoLidasPlataforma', 0) == resource.data.get('naoLidasPlataforma', 0) + 1));

      // Anexos (foto, print, áudio, PDF; até 4): o arquivo tem que estar na pasta deste chamado, do dono dele
      // (suporte/{dono}/{chamado}/{arquivo} no Storage, onde só o dono e a equipe leem).
      function anexoOk(a, dono) {
        return a is map && a.keys().hasOnly(['caminho', 'tipo', 'nome', 'tamanho', 'mime', 'duracao'])
          && a.caminho is string && a.caminho.matches('suporte/' + dono + '/' + chamadoId + '/[A-Za-z0-9._-]{1,80}')
          && a.tipo in ['imagem', 'audio', 'arquivo']
          && a.nome is string && a.nome.size() <= 200
          && a.tamanho is int && a.mime is string && a.mime.size() <= 100;
      }
      function anexosOk(l, dono) {
        return l is list && l.size() <= 4
          && (l.size() < 1 || anexoOk(l[0], dono)) && (l.size() < 2 || anexoOk(l[1], dono))
          && (l.size() < 3 || anexoOk(l[2], dono)) && (l.size() < 4 || anexoOk(l[3], dono));
      }

      match /mensagens/{mid} {
        allow read: if plataforma()
          || (logado() && get(/databases/$(database)/documents/suporte/$(chamadoId)).data.uid == request.auth.uid);
        allow create: if request.resource.data.keys().hasOnly(['autor', 'texto', 'nome', 'anexos', 'criadoEm'])
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 4000
          && (request.resource.data.texto.size() > 0 || request.resource.data.get('anexos', []).size() > 0)
          && anexosOk(request.resource.data.get('anexos', []), get(/databases/$(database)/documents/suporte/$(chamadoId)).data.uid)
          && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 200
          && request.resource.data.criadoEm == request.time && (
          (plataforma() && request.resource.data.autor == 'plataforma')
          || (logado() && get(/databases/$(database)/documents/suporte/$(chamadoId)).data.uid == request.auth.uid
              && request.resource.data.autor == 'usuario'));
        allow update, delete: if false;
      }
    }

    match /faq/{id} {
      allow read: if true;
      allow write: if plataforma();
    }

    // Erros capturados no navegador (alimentam a janela de depuração do suporte)
    match /logsErro/{id} {
      // Só com sessão (anônima serve), em nome de si mesmo, campos e tamanhos do web/src/lib/erros.ts e hora do servidor
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['torcidaId', 'uid', 'mensagem', 'stack', 'url', 'navegador', 'versao', 'contexto', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 2000
        && request.resource.data.get('stack', '') is string && request.resource.data.get('stack', '').size() <= 8000
        && request.resource.data.get('contexto', '') is string && request.resource.data.get('contexto', '').size() <= 8000
        && request.resource.data.get('url', '') is string && request.resource.data.get('url', '').size() <= 500
        && request.resource.data.get('navegador', '') is string && request.resource.data.get('navegador', '').size() <= 500
        && request.resource.data.get('versao', '') is string && request.resource.data.get('versao', '').size() <= 100
        && (request.resource.data.get('torcidaId', null) == null
            || (request.resource.data.torcidaId is string && request.resource.data.torcidaId.size() <= 64))
        && request.resource.data.criadoEm == request.time;
      allow read: if plataforma();
      allow update, delete: if false;
    }

    // Configuração pública da plataforma (planos e chave Pix da mensalidade)
    // Pix e planos da plataforma: só o servidor grava (salvarConfigPlataforma confere a lista da equipe e registra o histórico)
    match /plataforma/publico {
      allow read: if true;
      allow write: if false;
    }

    // Pedidos de cadastro de torcida feitos pela página principal
    match /solicitacoes/{id} {
      allow read: if plataforma() || (logado() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Verificação em vídeo do cadastro: o que a equipe conferiu e onde guardou a gravação (só a plataforma lê)
    match /verificacoesVideo/{id} {
      allow read: if plataforma();
      allow write: if false;
    }

    match /plataforma/{doc=**} {
      allow read: if plataforma();
      allow write: if false;
    }
  }
}
